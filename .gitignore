# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# IDE
.idea/
.vscode/
*.iml

# Env / secrets
.env
.env.*
!.env.example

# Local Postgres data (if running outside docker volume)
/pgdata
*.dump
/backups/

# SQLite seeds — large; live outside the repo
*.sqlite
*.db
!docs/**/*.sqlite
!tests/fixtures/**/seed.sqlite

# OS
.DS_Store
Thumbs.db

# Generated docs (regenerate locally; commit when stable)
# docs/generated/  # uncomment to ignore

# Detached-run logs
full-run.log
full-run-*.log
logs/
logs.*/
run-logs/

# Determinism-replay baselines (one dir per snapshot)
baselines/
