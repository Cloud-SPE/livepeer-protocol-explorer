# Layer 3 secrets (SPEC §16.1). NEVER commit a real .env.
# Copy to .env and fill in real values.

# --- Postgres ---
POSTGRES_USER=livepeer
POSTGRES_PASSWORD=changeme
POSTGRES_DB=livepeer_indexer
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://livepeer:changeme@postgres:5432/livepeer_indexer

# --- RPC providers ---
# Full URL with API key. SPEC §13.1.
# Archive primary — Chainstack (full Arbitrum archive).
CHAINSTACK_RPC_URL=
# Non-archive secondary — liveinfraspe (hosted HTTP, no archive).
SECONDARY_RPC_URL=
# Backwards-compatible alias used by older code paths; same value as SECONDARY_RPC_URL.
LOCAL_NITRO_URL=

# --- Alerting (SPEC §10.6, §16.1) ---
# Telegram only — no pager service in v1. Enabled in staging/prod, off in dev.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
RUST_LOG=info
