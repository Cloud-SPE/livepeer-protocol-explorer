# Layer 3 secrets (SPEC §16.1). NEVER commit a real .env.
# Copy to .env and fill in real values.

# --- Postgres ---
POSTGRES_USER=livepeer
POSTGRES_PASSWORD=changeme
POSTGRES_DB=livepeer_indexer
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://livepeer:changeme@postgres:5432/livepeer_indexer

# --- RPC providers ---
# Full URL with API key. SPEC §13.1.
# Archive primary — Chainstack (full Arbitrum archive).
CHAINSTACK_RPC_URL=
# Non-archive secondary — liveinfraspe (hosted HTTP, no archive).
SECONDARY_RPC_URL=
# Backwards-compatible alias used by older code paths; same value as SECONDARY_RPC_URL.
LOCAL_NITRO_URL=

# L1 (Ethereum mainnet) — required by livepeer-finality-watcher.
# Use an archive node when running TD-008 (SequencerInbox back-fill); a non-archive
# node is sufficient for the heuristic watcher v1.5.
L1_RPC_URL=
# Beacon (consensus layer) — currently unused; reserved.
L1_BEACON_URL=

# --- Alerting (SPEC §10.6, §16.1) ---
# Telegram only — no pager service in v1. Enabled in staging/prod, off in dev.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_BOT_BIND=0.0.0.0:9111

# --- Logging ---
RUST_LOG=info

# --- Diagnostics MCP server (livepeer-mcp-diag) ---
# Read-only DSN using the diag_ro role (provision once via scripts/diag_ro_role.sql).
# MUST be a distinct, SELECT-only role — not DATABASE_URL.
DIAG_DATABASE_URL=
# Bearer token required to call the /mcp endpoint over HTTP. Generate a strong,
# random value (e.g. `openssl rand -hex 32`).
DIAG_BEARER_TOKEN=
# Optional override of the Prometheus /metrics targets to scrape. Only the
# daemon, enricher, and api expose one; rollups are DB-only.
# DIAG_METRICS_ENDPOINTS=http://livepeer-daemon:9107/metrics,http://livepeer-enricher:9112/metrics,http://livepeer-api:8080/metrics
# Host-header allowlist for /mcp (rmcp DNS-rebinding guard, default localhost
# only). Behind a reverse proxy / Cloudflare tunnel the inbound Host is your
# public domain, which otherwise 403s — set it here (comma-separated for
# several), or `*` to disable the check (bearer/Access still protect it).
# DIAG_ALLOWED_HOSTS=livepeer-api-mcp.xode.app
